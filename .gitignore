# Python build and bytecode
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test, lint and coverage caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Credentials and local configuration
.env
.env.*
!.env.example
*.pem
*.key
/secrets/
/config.local.*
/secrets.local.toml
/local-fix.preview.json

# Local agent/tool settings, editors and OS
/.claude/
/.superpowers/
.idea/
.vscode/
.DS_Store
*.swp

# ReviewFlow runtime state and untrusted working copies
/.reviewflow/
/.worktrees/
/workspaces/
/target-repos/
/artifacts/local/
*.log

# Keep source-controlled fixtures, sanitized evaluations and dependency locks.
